      "name": "01 - Autenticación",
      "item": [
        {
          "name": "Login Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test(\"Contiene token\", () => pm.expect(data.token).to.be.a(\"string\").and.not.empty);",
                  "if (data.token) pm.collectionVariables.set(\"token\", data.token);",
                  "if (data.usuario?.id) pm.collectionVariables.set(\"usuarioAutenticadoId\", data.usuario.id);"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{adminCorreo}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
